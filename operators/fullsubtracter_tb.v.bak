module fullsubracter_tb;
  reg[2:0] data;
  wire borr,diff;
  fullsubracter  dut(.data(data),.borr(borr),.diff(diff));
  initial begin
   data=3'b000; #10;
   data=3'b001; #10;
   data=3'b010; #10;
   data=3'b011; #10;
   data=3'b100; #10;
   data=3'b101; #10;
  data=3'b110; #10;
  data=3'b111; #10;
   $finish;
 end
 initial 
     $monitor("time=%0t data=%b  diff=%b borr=%b",$time,data,diff,borr);

endmodule 
