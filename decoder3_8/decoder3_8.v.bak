module decoder3_8(
 input[2:0] I;
 output[7:0]D_out
);
assign D_out[7]=((I[2])&(I[1])&(I[0]));
assign D_out[6]=((I[2])&(I[1])&(~I[0]));
assign D_out[5]=((I[2])&(~I[1])&(I[0]));
assign D_out[4]=((I[2])&(~I[1])&(~I[0]));
assign D_out[3]=((~I[2])&(I[1])&(I[0]));
assign D_out[2]=((~I[2])&(I[1])&(~I[0]));
assign D_out[1]=((~I[2])&(~I[1])&(I[0]));
assign D_out[0]=((~I[2])&(~I[1])&(~I[0]));
endmodule

